# Foundry resource root (not the project endpoint); no trailing path required.
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_FOUNDRY_API_KEY=
# Deployment name of a model supporting strict structured outputs.
AZURE_FOUNDRY_DEPLOYMENT=gpt-4.1-mini
# Optional NWS contact identifier; use your own project contact in deployment.
NWS_USER_AGENT=DisasterPath-Hackathon/0.1

# Optional. The judge flow uses deterministic geometry until an Azure Maps
# deployment response is normalized and verified.
AZURE_MAPS_SUBSCRIPTION_KEY=
